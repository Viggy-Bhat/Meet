# Whisper Model Configuration
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=1
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_LANGUAGE=

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8010
MAX_UPLOAD_SIZE_MB=500
MAX_DOWNLOAD_SIZE_MB=520

# Security
BACKEND_API_KEY=your-secure-api-key-here
CORS_ORIGINS=https://your-domain.com,http://localhost:3005
REQUIRE_AUTH_ON_LOCALHOST=true
ALLOWED_URL_DOMAINS=utfs.io,ufs.sh,uploadthing.com

# Rate Limiting
RATE_LIMIT_TRANSCRIBE=5/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_STORAGE=memory://

# Logging
LOG_FORMAT=json
